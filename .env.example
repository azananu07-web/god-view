# --- HighLevel Marketplace app (Agency / "Company" distribution) ---
# Create the app at https://marketplace.gohighlevel.com -> My Apps.
# Distribution type: Agency (Sub-account access via agency token).
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Must exactly match a Redirect URL configured on the app.
GHL_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Your app's ID (the part before the dash in the client id) – used to list installed locations.
GHL_APP_ID=

# Random 32+ char string used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: custom value key on each sub-account that holds ad spend (synced from FB/Google via Zapier/Make).
# Value may be a total for the period ("1234.56") or JSON {"2026-10-29": 41.2, ...} keyed by day.
GHL_AD_SPEND_CUSTOM_VALUE=ad_spend_daily
